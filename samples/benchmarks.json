{
  "description": "Sample read-only OData requests for the SQL_main Customer, Order, OrderItem, and Product entity sets. Requests are relative to the application base URL.",
  "requests": [
    {
      "name": "Paged customer projection",
      "request": "GET /odata/Customers?$select=CustomerId,Name,City,State&$orderby=CustomerId&$top=100"
    },
    {
      "name": "Projected products",
      "request": "GET /odata/Products?$select=ProductId,Description,CatalogNumber,ProductStatusId&$top=100"
    },
    {
      "name": "Orders for a bill-to customer",
      "request": "GET /odata/Orders?$filter=BillToId%20eq%2042&$select=SalesOrderGenerationId,OrderDate,StatusCode,SalesTotal&$top=25"
    },
    {
      "name": "Customer profile with order lines and products",
      "request": "GET /odata/Customers(42)?$select=CustomerId,Name,City,State&$expand=Orders($select=SalesOrderGenerationId,OrderDate,StatusCode,SalesTotal;$expand=OrderItems($select=SalesOrderLineGenerationId,LineId,ShipQty,Price;$expand=Product($select=ProductId,Description,CatalogNumber)))"
    },
    {
      "name": "Single order with customer and product details",
      "request": "GET /odata/Orders('ORDER-GENERATION-ID')?$select=SalesOrderGenerationId,OrderDate,StatusCode,SalesTotal&$expand=Customer($select=CustomerId,Name),OrderItems($select=SalesOrderLineGenerationId,LineId,ShipQty,Price;$expand=Product($select=ProductId,Description,CatalogNumber))"
    }
  ],
  "queryOptions": [
    "$filter",
    "$select",
    "$expand",
    "$orderby",
    "$top (maximum 10000)",
    "$skip",
    "$count",
    "$skiptoken"
  ]
}
