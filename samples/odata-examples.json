{
  "description": "Examples use the current Company Management EDM. Sample values below are deterministic seed examples, not a live database response.",
  "odataSets": {
    "Customers": {
      "request": "GET /odata/Customers?$filter=Country eq 'USA'&$select=CustomerNumber,FirstName,LastName,Email&$orderby=CustomerId&$top=1",
      "response": {
        "@odata.context": "$metadata#Customers(CustomerNumber,FirstName,LastName,Email)",
        "value": [
          {
            "CustomerNumber": "CUST-00000001",
            "FirstName": "Avery",
            "LastName": "Singh",
            "Email": "customer1@example.test"
          }
        ]
      }
    },
    "Products": {
      "request": "GET /odata/Products?$filter=Category eq 'Electronics'&$select=Sku,ProductName,Category,UnitPrice&$orderby=ProductId&$top=1",
      "response": {
        "@odata.context": "$metadata#Products(Sku,ProductName,Category,UnitPrice)",
        "value": [
          {
            "Sku": "SKU-0000002",
            "ProductName": "Smart Display 2",
            "Category": "Electronics",
            "UnitPrice": 6.45
          }
        ]
      }
    },
    "Employees": {
      "request": "GET /odata/Employees?$filter=EmployeeNumber eq 'EMP-00000005'&$select=EmployeeNumber,FirstName,LastName,Department,Salary&$top=1",
      "response": {
        "@odata.context": "$metadata#Employees(EmployeeNumber,FirstName,LastName,Department,Salary)",
        "value": [
          {
            "EmployeeNumber": "EMP-00000005",
            "FirstName": "Jamie",
            "LastName": "Smith",
            "Department": "IT",
            "Salary": 40006.85
          }
        ]
      }
    },
    "Orders": {
      "request": "GET /odata/Orders?$expand=Customer,OrderItems($expand=Product)&$count=true&$orderby=OrderId&$top=1",
      "responseShape": {
        "@odata.context": "$metadata#Orders(Customer(),OrderItems(Product()))",
        "@odata.count": 500000,
        "value": [
          {
            "OrderId": 1,
            "CustomerId": 7919,
            "OrderNumber": "ORD-000000001",
            "OrderDate": "2021-01-08T00:00:00",
            "OrderStatus": "Shipped",
            "Subtotal": 11965.60,
            "TaxAmount": 987.16,
            "ShippingAmount": 9.95,
            "TotalAmount": 12962.71,
            "Customer": {
              "CustomerId": 7919,
              "CustomerNumber": "CUST-00007919"
            },
            "OrderItems": [
              {
                "OrderItemId": 1,
                "ProductId": 1004,
                "Quantity": 5,
                "UnitPrice": 737.91,
                "LineTotal": 3689.55,
                "Product": {
                  "ProductId": 1004,
                  "Sku": "SKU-0001004",
                  "ProductName": "Storage Drive 1004"
                }
              }
            ]
          }
        ],
        "note": "Abbreviated example: each seeded order has four order items."
      }
    },
    "OrderItems": {
      "request": "GET /odata/OrderItems?$expand=Order,Product&$top=100",
      "navigationProperties": [
        "Order",
        "Product"
      ]
    },
    "Branches": {
      "request": "GET /odata/Branches?$top=100",
      "note": "Retained for compatibility with the earlier branch demo."
    }
  },
  "queryOptions": [
    "$filter",
    "$select",
    "$expand",
    "$orderby",
    "$top (maximum 10000)",
    "$skip",
    "$count",
    "$skiptoken"
  ]
}
